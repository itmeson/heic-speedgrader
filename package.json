{
  "name": "heic-speedgrader",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome extension that displays HEIC/HEIF student submissions inside Canvas SpeedGrader. All decoding happens locally in the browser.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "libheif-js": "1.23.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itmeson/heic-speedgrader.git"
  },
  "homepage": "https://itmeson.github.io/heic-speedgrader/"
}
